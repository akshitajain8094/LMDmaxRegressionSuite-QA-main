# Copy to .env.<environment> (e.g. .env.staging, .env.qa) and fill in values.
# Pick the environment with TEST_ENV (defaults to staging).
API_BASE_URL=https://staging-api.fleet.lmdmax.com
UI_BASE_URL=https://staging.performance.lmdmax.com
LOGIN_EMAIL=
LOGIN_PASSWORD=
# Station the tests are written for (541 = DYY1)
TEST_STATION_ID=541
# In-app chat (Chat â†’ Paya Chat / Individual Chat)
MESSAGING_BASE_URL=https://staging-messaging.fleet.lmdmax.com
# Optional: the chat station, its owner and test driver (deleted-message chat tests). Without them: the test user and station.
CHAT_STATION_ID=
CHAT_STATION_CODE=
CHAT_OWNER_EMAIL=
CHAT_OWNER_PASSWORD=
CHAT_DRIVER_NAME=
# SMS / Twilio chat tests (tests/ui/sms, --project=ui-sms) on the chat station. They send real SMS ONLY to
# SMS_DRIVERS ("id:name,id:name"), and only when the run has SMS_SEND=1. SMS_INVALID_DRIVER_ID: a driver whose SMS
# fails (TC-028, TC-062, TC-067, TC-082); empty = those parts are skipped.
# Set for a run only (not here): SMS_LONG=1 also runs TC-052 (about 10 SMS to Chad); SMS_INBOUND=1 runs the @by-hand
# cases, where QA sends an SMS from Chad's phone when the terminal says "NOW, from …" (each waits up to 3 minutes).
SMS_DRIVERS=
SMS_INVALID_DRIVER_ID=
SMS_INVALID_DRIVER_NAME=
SMS_SECONDARY_NAME=
# Optional: a second admin and a promoted admin of the chat station (deleted-message chat tests).
# Without them, the tests that need them are skipped.
ADMIN_B_EMAIL=
ADMIN_B_PASSWORD=
PROMOTED_ADMIN_EMAIL=
PROMOTED_ADMIN_PASSWORD=
# Optional: announcements (tests/api/announcements, tests/ui/announcements.spec.js). Every announcement goes
# only to ANN_DRIVER_NAME, who gets a push notification and an SMS. Without them the announcement tests are skipped.
ANN_STATION_ID=
ANN_STATION_CODE=
ANN_OWNER_EMAIL=
ANN_OWNER_PASSWORD=
ANN_DRIVER_NAME=

# Rehire & Super Admin conflict tests (two different DSPs)
REHIRE_A_EMAIL=
REHIRE_A_PASSWORD=
REHIRE_A_STATION_ID=
REHIRE_A_STATION_CODE=
REHIRE_B_EMAIL=
REHIRE_B_PASSWORD=
REHIRE_B_STATION_ID=
REHIRE_B_STATION_CODE=
SUPER_ADMIN_URL=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Report upload tests (Workflow, --project=api-reports / ui-reports): a user and a station where uploads may
# overwrite a week of scorecard data (the app cannot delete an upload). Without them the report tests are skipped.
REPORT_EMAIL=
REPORT_PASSWORD=
REPORT_STATION_ID=
REPORT_STATION_CODE=
